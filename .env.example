DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id
# Optional: comma-separated server IDs for immediate command registration.
# If omitted, commands are registered globally.
DISCORD_GUILD_IDS=server-id-one,server-id-two

# Optional settings
DATABASE_PATH=./data/meetings.sqlite
SCHEDULER_INTERVAL_MS=15000
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/Los_Angeles
