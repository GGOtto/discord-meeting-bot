{
  "name": "discord-meeting-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A recurring Discord meeting bot with agendas, RSVPs, and useful low-noise reminders.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply discord-meeting-bot --remote",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
